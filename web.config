<?xml version="1.0" encoding="utf-8"?>
<!-- 
  HCP+ Inventario IT - Configuración para Subruta en IIS (Windows Server)
  Ubicación en el servidor: C:\inetpub\wwwroot\Inventario IT\web.config
  Subruta URL en IIS: http://<tu-servidor>/Inventario IT/
  Persistencia: Archivo local JSON (C:\inetpub\wwwroot\Inventario IT\data\inventario-data.json)
  Sin base de datos externa.
-->
<configuration>
  <system.webServer>
    <!-- Permitir nombres de subruta con espacios y caracteres especiales como 'Inventario IT' -->
    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>

    <!-- Reglas de Reverse Proxy hacia el proceso Node.js (Next.js en puerto 3000) -->
    <rewrite>
      <rules>
        <rule name="Inventario IT Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <!-- Servir archivos estáticos físicos directamente si existen -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <!-- Reenvía el tráfico a Node.js en localhost:3000 -->
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Soporte para tipos MIME estáticos de JSON y PDFs de auditoría -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".pdf" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
    </staticContent>

    <!-- Cabeceras HTTP de seguridad recomendadas -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
