<?xml version="1.0" encoding="utf-8"?>
<!-- 
  HCP+ Inventario IT - Configuración de IIS (Internet Information Services) para Windows Server
  Colocar en la raíz del sitio web: C:\inetpub\wwwroot\inventario-it\web.config
  Funciona sin base de datos (Persistencia en archivo JSON C:\inetpub\wwwroot\inventario-it\data\inventario-data.json)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="NextJS Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".pdf" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
